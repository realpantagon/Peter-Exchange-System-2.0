# Not a secret — this is the Cloudflare account that owns the peter-exchange
# D1 database and Worker. It lives here because `wrangler d1 *` ignores the
# `account_id` field in wrangler.toml and fails when a login can reach more
# than one account. The db:* scripts pass this file via --env-file.
CLOUDFLARE_ACCOUNT_ID=b76e4b50bfd52760bbbfec7ff7fc89c0
